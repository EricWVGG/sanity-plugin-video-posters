{
  "name": "sanity-plugin-video-posters",
  "version": "0.1.0",
  "description": "Generates poster images for Sanity video file fields, in the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricWVGG/sanity-plugin-video-posters.git"
  },
  "keywords": [
    "sanity",
    "sanity-plugin",
    "video",
    "poster"
  ],
  "license": "MIT",
  "author": "Eric Jacobsen <eric@wvgg.co>",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "link-watch": "plugin-kit link-watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/asset-utils": "^2.0.0",
    "@sanity/incompatible-plugin": "^1.0.5"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "10.4.4",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/ui": "^4.2.4",
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.11.0",
    "styled-components": "^6.3.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@sanity/ui": "^4.2.4",
    "react": "^19",
    "sanity": "^5.0.0 || ^6.0.0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "sanityPlugin": {
    "linkWatch": {
      "command": "pnpm run watch",
      "extensions": "js,png,svg,gif,jpeg,css"
    },
    "verifyPackage": {
      "eslintImports": false,
      "nodeEngine": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
